# macOS
.DS_Store

# Xcode / SwiftPM local artifacts
.swiftpm/
DerivedData/
*.xcresult
*.xcuserstate
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/

# Noir compiled artifacts (rebuild via: nargo compile --workspace)
circuits/target/

# Rust build artifacts
mopro-binding/target/
mopro-binding/build/
# Cargo.lock IS tracked: this crate produces the distributed xcframework, so
# CI/release must resolve identical deps. Leaving it untracked let fresh resolves
# drift (mopro-ffi 0.3.5 -> 0.3.6, uniffi 0.29 -> 0.31), breaking the build and
# producing a binary whose UniFFI contract mismatched the committed mopro.swift.
mopro-binding/MoproiOSBindings/
mopro-binding/MoproAndroidBindings/

# Zig build artifacts
mopro-binding/build-zig/

# Local generated vectors
mopro-binding/test-vectors/

# Benchmark reports (generated)
benchmark/reports/
!benchmark/reports/.gitkeep

# Swift Package build
.build/
Sources/MoproiOSBindings/MoproBindings.xcframework/**/*.a

# Ephemeral planning docs
plan.md

# Claude Code harness state (local scheduling locks etc.)
.claude/

# v3.1: legacy workspace build artifacts
circuits-legacy/target/
